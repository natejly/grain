#!/bin/bash
# Boot script for the single API + sandbox host.
#
# Four jobs, in order, and the third one is the one people forget:
#   1. join the ECS cluster
#   2. bring up the persistent data volume at ${data_mount}
#   3. pull the sandbox image into the HOST daemon, because no ECS task ever
#      references it — the API shells out to `docker run` and the image has to
#      already be there or container_provider raises "sandbox image is not
#      available"
#   4. install the nightly objects backup
set -euo pipefail
exec > >(tee /var/log/grain-bootstrap.log) 2>&1

REGION="${region}"
DATA_MOUNT="${data_mount}"
DATA_VOLUME_ID="${data_volume_id}"

# --- 1. ECS agent ----------------------------------------------------------
# ECS_ENABLE_TASK_IAM_ROLE is what makes the empty task role in iam.tf actually
# shadow the instance profile: without it the container falls through to IMDS.
cat >/etc/ecs/ecs.config <<EOF
ECS_CLUSTER=${cluster_name}
ECS_ENABLE_TASK_IAM_ROLE=true
ECS_ENABLE_TASK_IAM_ROLE_NETWORK_HOST=true
ECS_AVAILABLE_LOGGING_DRIVERS=["json-file","awslogs"]
ECS_ENABLE_CONTAINER_METADATA=true
ECS_IMAGE_PULL_BEHAVIOR=always
ECS_RESERVED_MEMORY=512
EOF

# --- 2. Persistent data volume --------------------------------------------
# On Nitro instances the requested device name (/dev/sdf) is not what appears in
# /dev; the volume shows up as an NVMe device whose serial is the volume id with
# the hyphen removed. Matching on the serial is the only stable way to find it.
SERIAL="$(echo "$DATA_VOLUME_ID" | tr -d '-')"
DEVICE=""
for _ in $(seq 1 60); do
  DEVICE="$(lsblk -dn -o NAME,SERIAL | awk -v s="$SERIAL" '$2 == s { print "/dev/" $1 }' | head -1)"
  [ -n "$DEVICE" ] && break
  sleep 2
done
if [ -z "$DEVICE" ]; then
  echo "FATAL: data volume $DATA_VOLUME_ID never appeared" >&2
  exit 1
fi

# blkid succeeds only on a formatted device, so this formats exactly once in the
# volume's life. Getting this wrong reformats the object store on every reboot.
if ! blkid "$DEVICE" >/dev/null 2>&1; then
  mkfs.xfs -L grain "$DEVICE"
fi

mkdir -p "$DATA_MOUNT"
grep -q "LABEL=grain" /etc/fstab || \
  echo "LABEL=grain $DATA_MOUNT xfs defaults,noatime,nofail 0 2" >>/etc/fstab
mount -a

# OBJECTS_DIR and SANDBOX_WORKDIR. The sandbox tree is world-traversable so the
# sandbox container (uid 65534, nobody) can reach its own session directory. The
# objects tree is not — only the API writes there.
#
# KNOWN BLOCKER, and these two lines do not solve it. The *session* directory is
# created by the API, which ecs.tf runs as root, by
# services/sandbox/local_exec.ensure_session_root -> Path.mkdir(), i.e. 0777 &
# ~umask = 0755 root:root. Ownership of the parent does not propagate to a
# child directory on Linux, so uid 65534 can traverse into the session directory
# and read the staged script but cannot create a file in it: every execution
# that writes an artefact (plt.savefig, a cleaned CSV) fails with EACCES while
# print-only code succeeds, which is why a smoke test misses it.
# scripts/verify_sandbox_container.py already detects this and names the fix as
# belonging in ensure_session_root. Nothing terraform can set — ECS exposes no
# umask, and the sandbox's --user is hardcoded in the driver — repairs it from
# out here. Do not deploy the execution feature until that lands.
mkdir -p "$DATA_MOUNT/objects" "$DATA_MOUNT/sandboxes"
chmod 0755 "$DATA_MOUNT" "$DATA_MOUNT/sandboxes"
chmod 0700 "$DATA_MOUNT/objects"

# --- 3. Sandbox image into the host daemon ---------------------------------
# The image URI lives in an SSM parameter rather than being baked in here, so
# rolling the sandbox image is `aws ssm put-parameter` plus a Run Command
# instead of replacing the instance. See docs/DEPLOY-AWS.md.
cat >/usr/local/bin/grain-sandbox-image <<'SCRIPT'
#!/bin/bash
set -euo pipefail
REGION="$(curl -sf -H "X-aws-ec2-metadata-token: $(curl -sf -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60')" http://169.254.169.254/latest/meta-data/placement/region)"
IMAGE="$(aws ssm get-parameter --region "$REGION" --name "__SANDBOX_IMAGE_PARAM__" --query 'Parameter.Value' --output text)"
REGISTRY="$${IMAGE%%/*}"
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$REGISTRY"
docker pull "$IMAGE"
# Nothing prunes automatically: an old sandbox image is the rollback target.
echo "sandbox image ready: $IMAGE"
SCRIPT
sed -i "s|__SANDBOX_IMAGE_PARAM__|${sandbox_image_param}|" /usr/local/bin/grain-sandbox-image
chmod 0755 /usr/local/bin/grain-sandbox-image

cat >/etc/systemd/system/grain-sandbox-image.service <<'EOF'
[Unit]
Description=Pull the Grain sandbox execution image into the host Docker daemon
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/grain-sandbox-image
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
EOF

# --- 4. Nightly objects backup --------------------------------------------
# No --delete. The IAM policy grants no s3:DeleteObject either, so a deletion on
# the host cannot propagate into the backup even if this flag changes.
# One line per command: a backslash continuation inside an unquoted heredoc is
# consumed by the shell writing the file, not preserved into it.
cat >/usr/local/bin/grain-backup <<EOF
#!/bin/bash
set -euo pipefail
aws s3 sync "$DATA_MOUNT/objects" "s3://${objects_bucket}/objects/" --region "$REGION" --only-show-errors --sse aws:kms --sse-kms-key-id "${kms_key_arn}"
echo "objects backup complete: \$(date -u +%FT%TZ)"
EOF
chmod 0755 /usr/local/bin/grain-backup

cat >/etc/systemd/system/grain-backup.service <<'EOF'
[Unit]
Description=Sync the object store to S3

[Service]
Type=oneshot
ExecStart=/usr/local/bin/grain-backup
EOF

# 07:10 UTC, inside the same window as the RDS backup (07:00-08:00) and the DLM
# snapshot, so the three artefacts are one logical recovery point rather than
# three unrelated ones. docs/RUNBOOK.md asks for exactly that.
cat >/etc/systemd/system/grain-backup.timer <<'EOF'
[Unit]
Description=Nightly object store backup

[Timer]
OnCalendar=*-*-* 07:10:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
EOF

# --- Host logs -------------------------------------------------------------
# Non-fatal on purpose: losing host log shipping is an observability problem,
# and aborting the boot script here would turn it into an outage.
if ! dnf install -y amazon-cloudwatch-agent >/dev/null; then
  echo "WARNING: cloudwatch agent install failed; host logs stay local" >&2
fi
if [ -d /opt/aws/amazon-cloudwatch-agent ]; then
cat >/opt/aws/amazon-cloudwatch-agent/etc/grain.json <<EOF
{
  "agent": { "metrics_collection_interval": 300 },
  "metrics": {
    "namespace": "${metrics_namespace}",
    "append_dimensions": { "InstanceId": "\$${aws:InstanceId}" },
    "aggregation_dimensions": [["InstanceId"]],
    "metrics_collected": {
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["$DATA_MOUNT", "/"],
        "metrics_collection_interval": 300,
        "drop_device": true
      },
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 300
      }
    }
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {"file_path": "/var/log/messages", "log_group_name": "${host_log_group}", "log_stream_name": "{instance_id}/messages"},
          {"file_path": "/var/log/grain-bootstrap.log", "log_group_name": "${host_log_group}", "log_stream_name": "{instance_id}/bootstrap"},
          {"file_path": "/var/log/ecs/ecs-agent.log", "log_group_name": "${host_log_group}", "log_stream_name": "{instance_id}/ecs-agent"}
        ]
      }
    }
  }
}
EOF
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/grain.json
fi

systemctl daemon-reload
systemctl enable --now grain-sandbox-image.service
systemctl enable --now grain-backup.timer
systemctl restart ecs || systemctl start ecs

echo "bootstrap complete"
