# Provider plugins and the working directory init creates. 600+ MB.
.terraform/
.terraform.lock.hcl

# State never lives in the repo: it holds the RDS master password, which is why
# versions.tf insists on an encrypted S3 backend.
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Real values. terraform.tfvars.example is the committed template.
# Every per-environment tfvars carries the same risk: SMTP_PASSWORD and any
# other extra_environment override lands in them verbatim.
terraform.tfvars
uat.tfvars
*.auto.tfvars

crash.log
crash.*.log
