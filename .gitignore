.DS_Store
.env
.venv/
# The pattern above only matches a directory; worktrees use a symlink to the
# main checkout's .venv so e2e's webServer command resolves, and that symlink
# must never be committed either (it once was, as a blob).
.venv
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
*.tsbuildinfo
*.pyc
*.db
*.sqlite3
data/
node_modules/
# Regenerated from node_modules by apps/web/scripts/sync-sandbox-assets.mjs.
apps/web/public/sandbox/
.next/
# Every Next dist dir, not a list of the ones we happened to think of. Runs set
# NEXT_DIST_DIR to keep out of each other's way (.next-e2e, .next-measure,
# .next-review, …), and enumerating them meant a new one was untracked-by-luck:
# a blanket `git add -A` during one such run committed 212 build artifacts.
.next-*/
apps/web/.next-*/
dist/
coverage/
playwright-report/
test-results/
# Playwright storage state: a live session cookie, minted per run.
apps/web/e2e/.auth/

# Next.js build output from review runs
apps/web/.next-review/
.vercel
