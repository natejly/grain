# Storage defaults are local; the model provider is not. OPENAI_API_KEY below is
# required — the API refuses to start without it.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/workspace.db
OBJECTS_DIR=./data/objects

# The only product mode. There is no offline fallback: without a key the API
# fails to start rather than booting into something that cannot answer. The key
# is read by the API only and is never sent to the web app.
#
# MODEL_PROVIDER=scripted is a test double that replays a JSON script
# (SCRIPTED_MODEL_SCRIPT) and only boots when APP_ENV is development or test. It
# backs the test and browser suites; it is not a way to run the product.
MODEL_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=1200

# --- Model pricing ------------------------------------------------------
# What each model costs, in USD per million tokens, as one JSON object:
#   {"<model>": {"input": …, "output": …, "cached_input": …}}
# "cached_input" is optional and falls back to "input".
#
# Unset by default, and that is deliberate rather than a gap. The API counts
# every token whether or not this is configured — `model_usage` rows and
# GET /api/admin/usage are complete either way — but a cost needs a price, and
# a price is something only the provider's price list knows. Shipping a guessed
# default would put a fabricated number on a dashboard labelled "cost", so a
# model with no rate here records its tokens and a NULL cost, and the admin
# route names it under "unpriced_models".
#
# Keyed by the exact model name you configure above, snapshot suffix included;
# there is no prefix matching, because "gpt-5" must not silently price
# "gpt-5-nano". Copy the current numbers from openai.com/api/pricing.
# MODEL_PRICES={"gpt-5.5":{"input":0,"output":0,"cached_input":0},"gpt-5-nano":{"input":0,"output":0},"text-embedding-3-small":{"input":0}}

# --- Spend ceiling (ADR 0008) -------------------------------------------
# A rolling per-workspace cap on model spend. Unset is unlimited, and an
# existing deployment must not discover a cap nobody chose — so every limit
# below is opt-in, and leaving this whole block commented out changes nothing.
#
# The window is rolling, not calendar: "the last N hours" as of the moment of
# the check. A calendar day lets a runaway loop spend the ceiling at 23:59 and
# the ceiling again a minute later.
# BUDGET_WINDOW_HOURS=24
#
# The money ceiling. It can only bound spend this deployment can price, so
# setting it with MODEL_PRICES empty and no token ceiling is refused at startup:
# the limit would be configured, displayed, and completely inert.
# BUDGET_USD_PER_WINDOW=50
#
# The token ceiling, and the honest answer to "what does a budget mean when
# cost is unknown". It works with no price list at all, so it is the one to set
# if you have not priced your models — and it is what bounds an unpriced model
# beside a dollar ceiling.
# BUDGET_TOKENS_PER_WINDOW=20000000
#
# What fraction of the ceiling unattended work (scheduled workflows) may spend,
# measured over its own spend rather than the workspace's. Nobody is watching a
# 3am DAG, so it is stopped at half the ceiling well before a person typing is.
# Set to 1.0 to hold both to the same bar. No effect when nothing above is set:
# there is no fraction of unlimited.
# UNATTENDED_BUDGET_FRACTION=0.5
#
# A run stopped by the ceiling parks — it does not die. It shows as
# `waiting_for_approval` with `paused_reason=budget`, keeps its state, and
# resumes when an owner raises the limit at PUT /api/admin/budget (a per
# workspace ceiling, which replaces these values for that workspace).

# --- Inbound email ------------------------------------------------------
# Mail sent to inbox+<token>@<this domain> lands as a new thread in the
# workspace that minted the token. Both settings are required for the feature
# to be live: the domain names the addresses the UI mints, and the secret is
# what your email provider's webhook presents as a bearer to
# POST /api/hooks/email/inbound (unset means that endpoint answers 503).
# INBOUND_EMAIL_DOMAIN=mail.example.com
# INBOUND_EMAIL_WEBHOOK_SECRET=change-me

# Production adapters
# DATABASE_URL=postgresql+psycopg://workspace:workspace@localhost:5432/workspace
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=workspace
# S3_SECRET_KEY=change-me
# S3_BUCKET=workspace-sources

# A comma-separated list. Tool execution is denied when this is empty.
TOOL_HOST_ALLOWLIST=api.github.com
MAX_UPLOAD_BYTES=10485760
MAX_TOOL_RESPONSE_BYTES=262144

# --- Server-side code execution (ADR 0005) ------------------------------
# Off by default. Leave it off and the product has no execution tools at all:
# no driver is imported, and the model is never offered run_python. Everything
# below only matters once this is 1.
# SANDBOX_ENABLED=1
#
# Which driver actually runs the code:
#   container  — `docker run --rm` per execution with --network none,
#                --read-only, --cap-drop ALL, non-root, pid/memory/cpu limits.
#                THE DEPLOYMENT TARGET. Needs a Docker socket the API can reach
#                (`make sandbox-image` builds the image from
#                infra/sandbox/Dockerfile). Fargate cannot spawn containers from
#                a task, so a Fargate deploy needs an EC2 executor or `e2b`.
#   e2b        — hosted Firecracker microVMs. Real isolation, but your users'
#                documents leave your infrastructure and are processed by a
#                third party. Requires SANDBOX_API_KEY.
#   subprocess — NOT A SANDBOX. Runs generated code as the API process's own
#                user, which can read this .env file, the database and
#                ~/.aws/credentials. It exists so the tool and approval paths
#                can be exercised on a laptop without Docker. Settings refuse to
#                construct with it unless APP_ENV is development or test.
#   fake       — executes nothing; the test double. Same refusal as subprocess.
# SANDBOX_PROVIDER=container
# SANDBOX_API_KEY=replace-with-e2b-key
# SANDBOX_CONTAINER_IMAGE=grain-sandbox:latest
#
# Egress. Read this one before changing it.
#   none      — the default, and the reason this feature has no exfiltration
#               story. Code can read every document you gave it and has nowhere
#               to send them. The cost is that `pip install` does not work at
#               runtime: whatever the agent might import has to already be in
#               infra/sandbox/Dockerfile, and adding a library is an image
#               rebuild and a redeploy.
#   allowlist — only the hosts in SANDBOX_HOST_ALLOWLIST. Use this if you need
#               a package index or one named API. An EMPTY allowlist means
#               nothing is reachable, not everything.
#   open      — full egress, and a deliberate choice with a named cost. A
#               document the agent was asked to analyse can carry instructions,
#               the agent writes code that honours them, and that code has both
#               your data and a socket. No sandbox escape is needed for that and
#               no container flag prevents it. `open` is not "the convenient
#               default" — it is the setting that re-opens the only serious risk
#               in this feature. See docs/THREAT_MODEL.md.
# Cloud metadata (169.254.169.254) and private/link-local space are denied under
# every policy including `open`. That denial is in code, not here, on purpose.
# SANDBOX_NETWORK_POLICY=none
# SANDBOX_HOST_ALLOWLIST=pypi.org,files.pythonhosted.org,registry.npmjs.org
#
# Limits, enforced before a machine is created rather than discovered on a bill.
# SANDBOX_MAX_CONCURRENT_PER_WORKSPACE=3
# SANDBOX_MAX_EXECS_PER_RUN=20
# SANDBOX_EXEC_TIMEOUT_SECONDS=120
# SANDBOX_SESSION_TIMEOUT_SECONDS=900
# Idle sessions are killed after this many days: a paused sandbox keeps its
# filesystem — and its copy of your documents — at the driver until it is.
# SANDBOX_SESSION_IDLE_DAYS=7
# SANDBOX_MAX_OUTPUT_BYTES=65536

# Long-term chat memory (extraction, recall, and embeddings when OpenAI is on).
MEMORY_ENABLED=true
# A corrected fact retires the one it replaces, so recall never serves a claim
# beside its own contradiction. 0 restores the pre-claim-key write path; the
# effect is measured both ways by apps/api/scripts/evaluate_memory.py.
MEMORY_SUPERSESSION=true
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Past-conversation search: transcripts chunked and summarized per thread, so
# the search_conversations tool can quote what was actually said (with the
# thread's title and date). Indexed after each run and self-healing at search
# time; scripts/backfill_conversation_index.py indexes pre-existing history.
# Off, nothing is indexed and the tool reports the feature disabled.
CONVERSATION_INDEX_ENABLED=true

# Document retrieval. Three stages, each switchable on its own so each can be
# ablated: apps/api/scripts/evaluate_retrieval.py --stages measures all four
# configurations. Measured on the eval corpus, overall recall@5:
#   lexical only 82.1% -> +BM25 89.3% -> +dense/RRF 100%.
# BM25 with IDF over the portable chunk_terms index. 0 restores the pre-BM25
# term-frequency scorer.
RETRIEVAL_BM25=true
# The dense arm and RRF fusion. Needs an embedding provider; without one,
# retrieval simply stays lexical.
RETRIEVAL_HYBRID=true
# A one-sentence situating blurb per chunk at ingest (Contextual Retrieval).
# Off by default: it costs an LLM call per chunk and measured as a no-op on our
# corpus, whose documents are short enough to be self-contained already. Worth
# switching on for a corpus of long documents — and worth re-measuring there.
RETRIEVAL_CONTEXTUAL=false

# Integrations (Gmail via Google OAuth, Strava). All are optional; the
# Integrations view shows providers as "not configured" until these are set.
# Generate the encryption key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INTEGRATIONS_ENCRYPTION_KEY=replace-with-fernet-key
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-with-secret
# STRAVA_CLIENT_ID=12345
# STRAVA_CLIENT_SECRET=replace-with-secret
# OAUTH_REDIRECT_BASE=http://127.0.0.1:8000

# --- Authentication -----------------------------------------------------
# Sessions are opaque cookies; only the SHA-256 of each token is stored. The
# cookie must be SameSite=None (the web app is on another origin) and browsers
# only honour that with Secure, so SESSION_COOKIE_SECURE=false is refused
# unless APP_ENV is development or test. Chrome accepts Secure cookies on
# http://localhost and http://127.0.0.1, so local development needs no change.
# The cookie name is still the pre-rename `fieldnote_session`: it is wire
# format, not a user-visible surface, and changing it would sign every
# existing session out. This line mirrors the default in app/config.py.
# SESSION_COOKIE_NAME=fieldnote_session
# SESSION_COOKIE_DOMAIN=.example.com
# SESSION_TTL_HOURS=336
# SameSite=None re-opens CSRF, so every POST/PUT/PATCH/DELETE must echo the
# session's CSRF token in this header. GET/HEAD are exempt.
# CSRF_HEADER_NAME=X-CSRF-Token
# PASSWORD_MIN_LENGTH=12
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# AUTH_RATE_LIMIT_ATTEMPTS=20
# AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Email delivery for verification and password-reset links. `console` prints the
# link to stdout and only does so when APP_ENV is development or test — outside
# it, the message is dropped with a warning rather than writing a live
# credential into a log. Configure SMTP for anything real.
# EMAIL_SENDER=smtp
# EMAIL_FROM=no-reply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=replace-with-secret
# SMTP_STARTTLS=true

# Google *login*. Deliberately a different OAuth client from GOOGLE_CLIENT_ID
# above, which is the Gmail data integration: login asks only for identity
# scopes, and a mailbox grant must never double as proof of who someone is.
# GOOGLE_LOGIN_CLIENT_ID=your-login-client-id.apps.googleusercontent.com
# GOOGLE_LOGIN_CLIENT_SECRET=replace-with-secret
# GOOGLE_LOGIN_REDIRECT_URI=https://api.example.com/api/auth/google/callback
# AUTH_POST_LOGIN_REDIRECT=https://app.example.com

# Resolves a cookie-less request to the seeded development identity. This is the
# header-trust hole the auth work removed, kept only so the browser suite can
# run before the web app has a sign-in screen. Settings refuse to construct with
# it enabled unless APP_ENV is development or test.
# DEV_AUTO_LOGIN=true

# Local one-click sign-in on the login screen. Only the allowlisted handle `lyn`
# is accepted, and only when APP_ENV is development or test. Creates
# lyn@local.dev on first use and issues a real session cookie.
# DEV_USER=lyn
