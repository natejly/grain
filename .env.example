# Storage defaults are local; the model provider is not. OPENAI_API_KEY below is
# required — the API refuses to start without it.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
DATABASE_URL=sqlite:///./data/workspace.db
OBJECTS_DIR=./data/objects

# The only product mode. There is no offline fallback: without a key the API
# fails to start rather than booting into something that cannot answer. The key
# is read by the API only and is never sent to the web app.
#
# MODEL_PROVIDER=scripted is a test double that replays a JSON script
# (SCRIPTED_MODEL_SCRIPT) and only boots when APP_ENV is development or test. It
# backs the test and browser suites; it is not a way to run the product.
MODEL_PROVIDER=openai
OPENAI_API_KEY=replace-with-your-key
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_OUTPUT_TOKENS=1200

# Production adapters
# DATABASE_URL=postgresql+psycopg://workspace:workspace@localhost:5432/workspace
# REDIS_URL=redis://localhost:6379/0
# S3_ENDPOINT=http://localhost:9000
# S3_ACCESS_KEY=workspace
# S3_SECRET_KEY=change-me
# S3_BUCKET=workspace-sources

# A comma-separated list. Tool execution is denied when this is empty.
TOOL_HOST_ALLOWLIST=api.github.com
MAX_UPLOAD_BYTES=10485760
MAX_TOOL_RESPONSE_BYTES=262144

# Long-term chat memory (extraction, recall, and embeddings when OpenAI is on).
MEMORY_ENABLED=true
# A corrected fact retires the one it replaces, so recall never serves a claim
# beside its own contradiction. 0 restores the pre-claim-key write path; the
# effect is measured both ways by apps/api/scripts/evaluate_memory.py.
MEMORY_SUPERSESSION=true
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Document retrieval. Three stages, each switchable on its own so each can be
# ablated: apps/api/scripts/evaluate_retrieval.py --stages measures all four
# configurations. Measured on the eval corpus, overall recall@5:
#   lexical only 82.1% -> +BM25 89.3% -> +dense/RRF 100%.
# BM25 with IDF over the portable chunk_terms index. 0 restores the pre-BM25
# term-frequency scorer.
RETRIEVAL_BM25=true
# The dense arm and RRF fusion. Needs an embedding provider; without one,
# retrieval simply stays lexical.
RETRIEVAL_HYBRID=true
# A one-sentence situating blurb per chunk at ingest (Contextual Retrieval).
# Off by default: it costs an LLM call per chunk and measured as a no-op on our
# corpus, whose documents are short enough to be self-contained already. Worth
# switching on for a corpus of long documents — and worth re-measuring there.
RETRIEVAL_CONTEXTUAL=false

# Integrations (Gmail via Google OAuth, Strava). All are optional; the
# Integrations view shows providers as "not configured" until these are set.
# Generate the encryption key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# INTEGRATIONS_ENCRYPTION_KEY=replace-with-fernet-key
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-with-secret
# STRAVA_CLIENT_ID=12345
# STRAVA_CLIENT_SECRET=replace-with-secret
# OAUTH_REDIRECT_BASE=http://127.0.0.1:8000

# --- Authentication -----------------------------------------------------
# Sessions are opaque cookies; only the SHA-256 of each token is stored. The
# cookie must be SameSite=None (the web app is on another origin) and browsers
# only honour that with Secure, so SESSION_COOKIE_SECURE=false is refused
# unless APP_ENV is development or test. Chrome accepts Secure cookies on
# http://localhost and http://127.0.0.1, so local development needs no change.
# The cookie name is still the pre-rename `fieldnote_session`: it is wire
# format, not a user-visible surface, and changing it would sign every
# existing session out. This line mirrors the default in app/config.py.
# SESSION_COOKIE_NAME=fieldnote_session
# SESSION_COOKIE_DOMAIN=.example.com
# SESSION_TTL_HOURS=336
# SameSite=None re-opens CSRF, so every POST/PUT/PATCH/DELETE must echo the
# session's CSRF token in this header. GET/HEAD are exempt.
# CSRF_HEADER_NAME=X-CSRF-Token
# PASSWORD_MIN_LENGTH=12
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_MINUTES=15
# AUTH_RATE_LIMIT_ATTEMPTS=20
# AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Email delivery for verification and password-reset links. `console` prints the
# link to stdout and only does so when APP_ENV is development or test — outside
# it, the message is dropped with a warning rather than writing a live
# credential into a log. Configure SMTP for anything real.
# EMAIL_SENDER=smtp
# EMAIL_FROM=no-reply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=replace-with-secret
# SMTP_STARTTLS=true

# Google *login*. Deliberately a different OAuth client from GOOGLE_CLIENT_ID
# above, which is the Gmail data integration: login asks only for identity
# scopes, and a mailbox grant must never double as proof of who someone is.
# GOOGLE_LOGIN_CLIENT_ID=your-login-client-id.apps.googleusercontent.com
# GOOGLE_LOGIN_CLIENT_SECRET=replace-with-secret
# GOOGLE_LOGIN_REDIRECT_URI=https://api.example.com/api/auth/google/callback
# AUTH_POST_LOGIN_REDIRECT=https://app.example.com

# Resolves a cookie-less request to the seeded development identity. This is the
# header-trust hole the auth work removed, kept only so the browser suite can
# run before the web app has a sign-in screen. Settings refuse to construct with
# it enabled unless APP_ENV is development or test.
# DEV_AUTO_LOGIN=true

# Local one-click sign-in on the login screen. Only the allowlisted handle `lyn`
# is accepted, and only when APP_ENV is development or test. Creates
# lyn@local.dev on first use and issues a real session cookie.
# DEV_USER=lyn
